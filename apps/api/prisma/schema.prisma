generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_OWNER
  CLINIC_ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  PHARMACIST
  LABORATORY_TECHNICIAN
  ACCOUNTANT
  PATIENT
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum MedicalConditionStatus {
  ACTIVE
  CONTROLLED
  RESOLVED
}

enum EncounterType {
  OPD
  IPD
}

enum EncounterStatus {
  OPEN
  CLOSED
}

enum TemperatureUnit {
  CELSIUS
  FAHRENHEIT
}

enum HeightUnit {
  CENTIMETERS
  FEET_INCHES
}

enum WeightUnit {
  KILOGRAMS
  POUNDS
}

enum PrescriptionMedicationSection {
  INJECTION
  NEBULIZATION
  TABLET
}

enum AppointmentSlotStatus {
  AVAILABLE
  BOOKED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueTokenPriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum PatientVisitType {
  NEW
  EXISTING
}

enum QueueTokenStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NurseIntakeStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum NurseAllergyStatus {
  CONFIRMED_NONE
  HAS_ALLERGIES
  NOT_CONFIRMED
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PharmacyOrderStatus {
  RECEIVED
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

enum PharmacyOrderChannel {
  PHONE
  WEBSITE
  MESSAGING
  OTHER
}

enum MedicineStockMovementType {
  RECEIVED
  DISPENSED
  ADJUSTED
}

enum ConsumableStockMovementType {
  RECEIVED
  DISPENSED
  ADJUSTED
  DAMAGED
  EXPIRED
}

enum NursingOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MedicationAdministrationStatus {
  PENDING
  DUE
  ADMINISTERED
  PARTIALLY_ADMINISTERED
  HELD
  MISSED
  REFUSED
  CANCELLED
}

enum LabProcedureStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceRefundStatus {
  COMPLETED
  CANCELLED
}

enum InvoiceTemplate {
  PROFESSIONAL
  DETAILED
  THERMAL
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

model Clinic {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String
  phone                     String?
  email                     String?
  address                   String?
  practitionerName          String?
  registrationNumber        String?
  taxId                     String?
  currency                  String                     @default("INR")
  invoiceFooter             String?
  vitalReferenceRanges      Json?
  nextInvoiceNumber         Int                        @default(1)
  nextPurchaseOrderNumber   Int                        @default(1)
  nextPharmacyOrderNumber   Int                        @default(1)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  patients                  Patient[]
  patientIdSequence         PatientIdSequence?
  patientDrafts             PatientDraft[]
  slots                     AppointmentSlot[]
  appointments              Appointment[]
  queueTokens               QueueToken[]
  queueSequences            QueueSequence[]
  medicines                 Medicine[]
  stockMovements            MedicineStockMovement[]
  suppliers                 Supplier[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderItems        PurchaseOrderItem[]
  purchaseReceipts          PurchaseReceipt[]
  purchaseReceiptItems      PurchaseReceiptItem[]
  pharmacyOrders            PharmacyOrder[]
  pharmacyOrderItems        PharmacyOrderItem[]
  services                  ClinicService[]
  prescriptionDispenses     PrescriptionDispense[]
  vitalsRecords             PatientVitals[]
  consumableCategories      ConsumableCategory[]
  consumables               Consumable[]
  consumableMovements       ConsumableStockMovement[]
  invoices                  Invoice[]
  invoiceItems              InvoiceItem[]
  payments                  InvoicePayment[]
  encounters                PatientEncounter[]
  externalMedicalRecords    ExternalMedicalRecord[]
  patientIntakes            NurseIntake[]
  prescriptionItems         PrescriptionItem[]
  patientReports            PatientReport[]
  consultationPrescriptions ConsultationPrescription[]
  prescriptionMedications   PrescriptionMedication[]
  nursingOrders             NursingOrder[]
  medicationAdministrations MedicationAdministration[]
  labOrders                 LabOrder[]
  procedureOrders           ProcedureOrder[]
  invoiceRefunds            InvoiceRefund[]
  medicalConditions         PatientMedicalCondition[]
  familyHistoryMembers      FamilyHistoryMember[]
  familyHistoryConditions   FamilyHistoryCondition[]
  personalHistories         PatientPersonalHistory[]
  femaleHistories           PatientFemaleHistory[]
}

model User {
  id                               String                     @id @default(uuid()) @db.Uuid
  clinicId                         String                     @db.Uuid
  email                            String                     @unique
  passwordHash                     String
  role                             UserRole
  active                           Boolean                    @default(true)
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
  clinic                           Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctorSlots                      AppointmentSlot[]          @relation("DoctorSlots")
  doctorAppointments               Appointment[]              @relation("DoctorAppointments")
  doctorQueueTokens                QueueToken[]               @relation("QueueDoctor")
  createdQueueTokens               QueueToken[]               @relation("QueueCreatedBy")
  queueSequences                   QueueSequence[]            @relation("QueueSequenceDoctor")
  stockMovements                   MedicineStockMovement[]
  createdPurchaseOrders            PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  receivedPurchaseReceipts         PurchaseReceipt[]          @relation("PurchaseReceiptReceivedBy")
  createdPharmacyOrders            PharmacyOrder[]             @relation("PharmacyOrderCreatedBy")
  consumableMovements              ConsumableStockMovement[]
  invoices                         Invoice[]
  voidedInvoices                   Invoice[]                  @relation("InvoiceVoidedBy")
  invoicePayments                  InvoicePayment[]
  createdEncounters                PatientEncounter[]
  createdExternalMedicalRecords    ExternalMedicalRecord[]    @relation("ExternalMedicalRecordCreatedBy")
  createdPatientIntakes            NurseIntake[]              @relation("PatientIntakeCreatedBy")
  reviewedPatientIntakes           NurseIntake[]              @relation("PatientIntakeReviewedBy")
  patientDrafts                    PatientDraft[]
  refreshSessions                  RefreshSession[]
  auditLogs                        AuditLog[]
  createdConsultationPrescriptions ConsultationPrescription[]
  prescriptionDispenses            PrescriptionDispense[]
  createdNursingOrders             NursingOrder[]             @relation("NursingOrderCreatedBy")
  medicationAdministrations        MedicationAdministration[] @relation("MedicationAdministeredBy")
  confirmedLabOrders               LabOrder[]                 @relation("LabOrderConfirmedBy")
  confirmedProcedureOrders         ProcedureOrder[]           @relation("ProcedureConfirmedBy")
  invoiceRefunds                   InvoiceRefund[]            @relation("InvoiceRefundedBy")
  recordedVitals                   PatientVitals[]
  registeredPatients               Patient[]                  @relation("PatientRegisteredBy")

  @@unique([clinicId, id])
  @@index([clinicId, role])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Patient {
  id                           String                     @id @default(uuid()) @db.Uuid
  clinicId                     String                     @db.Uuid
  patientCode                  String
  fullName                     String
  dateOfBirth                  DateTime?                  @db.Date
  gender                       Gender                     @default(UNSPECIFIED)
  mobile                       String
  email                        String?
  address                      String?
  city                         String?
  state                        String?
  postalCode                   String?
  relationToAccount            String?
  emergencyContact             String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyPhone               String?
  occupation                   String?
  maritalStatus                String?
  preferredLanguage            String?
  insuranceProvider            String?
  insuranceNumber              String?
  insuranceSumInsured          Decimal?                   @db.Decimal(12, 2)
  profilePhotoDataUrl          String?                    @db.Text
  bloodGroup                   String?
  allergies                    String?
  medicalHistory               String?
  surgicalHistory              String?
  familyHistory                String?
  currentMedications           String?
  status                       PatientStatus              @default(ACTIVE)
  registeredById               String?                    @db.Uuid
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  clinic                       Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  registeredBy                 User?                      @relation("PatientRegisteredBy", fields: [clinicId, registeredById], references: [clinicId, id], onDelete: Restrict)
  appointments                 Appointment[]
  pharmacyOrders              PharmacyOrder[]
  queueTokens                  QueueToken[]
  nurseIntakes                 NurseIntake[]
  invoices                     Invoice[]
  encounters                   PatientEncounter[]
  consultationPrescriptions    ConsultationPrescription[]
  nursingOrders                NursingOrder[]
  labOrders                    LabOrder[]
  procedureOrders              ProcedureOrder[]
  externalMedicalRecords       ExternalMedicalRecord[]
  medicalConditions            PatientMedicalCondition[]
  familyHistoryMembers         FamilyHistoryMember[]
  personalHistory              PatientPersonalHistory?
  femaleHistory                PatientFemaleHistory?
  vitalsRecords                PatientVitals[]

  @@unique([clinicId, id])
  @@unique([clinicId, patientCode])
  @@index([clinicId, fullName])
  @@index([clinicId, mobile])
  @@index([clinicId, status])
}

model PatientIdSequence {
  clinicId    String @id @db.Uuid
  lastOrdinal BigInt @default(0)
  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
}

model PatientMedicalCondition {
  id                String                 @id @default(uuid()) @db.Uuid
  clinicId          String                 @db.Uuid
  patientId         String                 @db.Uuid
  condition         String
  diagnosedAt       DateTime?              @db.Date
  currentMedication String?
  previousTreatment String?
  status            MedicalConditionStatus @default(ACTIVE)
  doctorRemarks     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  clinic            Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient           Patient                @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Cascade)

  @@unique([clinicId, id])
  @@index([clinicId, patientId, status, createdAt])
}

model FamilyHistoryMember {
  id                 String                   @id @default(uuid()) @db.Uuid
  clinicId           String                   @db.Uuid
  patientId          String                   @db.Uuid
  relationship       String
  customRelationship String?
  ageAtDiagnosis     Int?
  remarks            String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  clinic             Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient            Patient                  @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Cascade)
  conditions         FamilyHistoryCondition[]

  @@unique([clinicId, id])
  @@index([clinicId, patientId, createdAt])
}

model FamilyHistoryCondition {
  id             String              @id @default(uuid()) @db.Uuid
  clinicId       String              @db.Uuid
  familyMemberId String              @db.Uuid
  condition      String
  createdAt      DateTime            @default(now())
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  familyMember   FamilyHistoryMember @relation(fields: [clinicId, familyMemberId], references: [clinicId, id], onDelete: Cascade)

  @@unique([clinicId, id])
  @@index([clinicId, familyMemberId])
}

model PatientPersonalHistory {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @db.Uuid
  patientId        String   @db.Uuid
  alcohol          Boolean?
  alcoholFrequency String?
  alcoholQuantity  String?
  smoking          Boolean?
  smokingDuration  String?
  tobaccoChewing   Boolean?
  tobaccoDuration  String?
  coffeePerDay     Int?
  teaPerDay        Int?
  sleepAdequate    Boolean?
  sleepingHours    Decimal? @db.Decimal(4, 1)
  otherHabits      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient          Patient  @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Cascade)

  @@unique([clinicId, id])
  @@unique([clinicId, patientId])
}

model PatientFemaleHistory {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicId            String    @db.Uuid
  patientId           String    @db.Uuid
  menstrualCycle      String?
  lastMenstrualPeriod DateTime? @db.Date
  cycleDurationDays   Int?
  menstrualComplaints String?
  whiteDischarge      Boolean?
  dischargeDuration   String?
  associatedSymptoms  String?
  doctorRemarks       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  clinic              Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient             Patient   @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Cascade)

  @@unique([clinicId, id])
  @@unique([clinicId, patientId])
}

model PatientDraft {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  createdById String   @db.Uuid
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdBy   User     @relation(fields: [clinicId, createdById], references: [clinicId, id], onDelete: Restrict)

  @@index([clinicId, updatedAt])
  @@index([clinicId, createdById, updatedAt])
}

model AppointmentSlot {
  id           String                @id @default(uuid()) @db.Uuid
  clinicId     String                @db.Uuid
  doctorId     String                @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentSlotStatus @default(AVAILABLE)
  createdAt    DateTime              @default(now())
  clinic       Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor       User                  @relation("DoctorSlots", fields: [doctorId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  queueToken   QueueToken?           @relation(fields: [queueTokenId], references: [id])
  queueTokenId String?               @db.Uuid

  @@unique([doctorId, startsAt])
  @@index([clinicId, startsAt, status])
  @@index([doctorId, startsAt, endsAt])
}

model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  clinicId   String            @db.Uuid
  patientId  String            @db.Uuid
  doctorId   String            @db.Uuid
  slotId     String            @db.Uuid
  reason     String?
  status     AppointmentStatus @default(BOOKED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  clinic     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor     User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)
  slot       AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Restrict)
  queueToken QueueToken?

  @@index([clinicId, status, createdAt])
  @@index([doctorId, status])
  @@index([patientId, createdAt])
  @@index([slotId])
}

model QueueSequence {
  clinicId        String   @db.Uuid
  doctorId        String   @db.Uuid
  queueDate       DateTime @db.Date
  lastTokenNumber Int      @default(0)
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor          User     @relation("QueueSequenceDoctor", fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Restrict)

  @@id([clinicId, doctorId, queueDate])
}

model QueueToken {
  id               String             @id @default(uuid()) @db.Uuid
  clinicId         String             @db.Uuid
  patientId        String             @db.Uuid
  doctorId         String             @db.Uuid
  createdById      String             @db.Uuid
  appointmentId    String?            @unique @db.Uuid
  queueDate        DateTime           @db.Date
  tokenNumber      Int
  priority         QueueTokenPriority @default(NORMAL)
  patientType      PatientVisitType   @default(EXISTING)
  department       String?
  status           QueueTokenStatus   @default(WAITING)
  reason           String?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  noShowAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient          Patient            @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  doctor           User               @relation("QueueDoctor", fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Restrict)
  createdBy        User               @relation("QueueCreatedBy", fields: [clinicId, createdById], references: [clinicId, id], onDelete: Restrict)
  appointment      Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  appointmentSlots AppointmentSlot[]
  nurseIntake      NurseIntake?
  encounter        PatientEncounter?

  @@unique([clinicId, doctorId, queueDate, tokenNumber])
  @@unique([clinicId, id])
  @@index([clinicId, queueDate, status, priority, tokenNumber])
  @@index([clinicId, patientId, queueDate])
  @@index([clinicId, doctorId, queueDate, status])
}

model NurseIntake {
  id                  String             @id @default(uuid()) @db.Uuid
  clinicId            String             @db.Uuid
  queueTokenId        String             @unique @db.Uuid
  patientId           String             @db.Uuid
  enteredById         String             @db.Uuid
  reviewedById        String?            @db.Uuid
  status              NurseIntakeStatus  @default(DRAFT)
  chiefComplaint      String
  onset               String?
  symptoms            String?
  allergyStatus       NurseAllergyStatus @default(NOT_CONFIRMED)
  allergyDetails      String?
  medicationsReviewed Boolean            @default(false)
  medicationNotes     String?
  painScore           Int?
  bloodPressure       String?
  temperatureC        Decimal?           @db.Decimal(5, 2)
  pulseBpm            Int?
  spo2Percent         Decimal?           @db.Decimal(5, 2)
  cbgMgDl             Decimal?           @db.Decimal(7, 2)
  weightKg            Decimal?           @db.Decimal(6, 2)
  heightCm            Decimal?           @db.Decimal(6, 2)
  bmi                 Decimal?           @db.Decimal(5, 2)
  nurseNotes          String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  clinic              Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  queueToken          QueueToken         @relation(fields: [clinicId, queueTokenId], references: [clinicId, id], onDelete: Cascade)
  patient             Patient            @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  enteredBy           User               @relation("PatientIntakeCreatedBy", fields: [clinicId, enteredById], references: [clinicId, id], onDelete: Restrict)
  reviewedBy          User?              @relation("PatientIntakeReviewedBy", fields: [clinicId, reviewedById], references: [clinicId, id], onDelete: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, queueTokenId])
  @@index([clinicId, status, submittedAt])
  @@index([clinicId, patientId, createdAt])
}

model PatientEncounter {
  id                   String                     @id @default(uuid()) @db.Uuid
  clinicId             String                     @db.Uuid
  patientId            String                     @db.Uuid
  createdById          String                     @db.Uuid
  encounterType        EncounterType
  status               EncounterStatus            @default(OPEN)
  visitDate            DateTime                   @db.Date
  doctorName           String
  symptoms             String?
  consultationNotes    String?
  diagnosis            String?
  bloodPressure        String?
  temperatureC         Decimal?                   @db.Decimal(5, 2)
  spo2Percent          Decimal?                   @db.Decimal(5, 2)
  cbgMgDl              Decimal?                   @db.Decimal(7, 2)
  weightKg             Decimal?                   @db.Decimal(6, 2)
  heightCm             Decimal?                   @db.Decimal(6, 2)
  bmi                  Decimal?                   @db.Decimal(5, 2)
  pulseBpm             Int?
  knownCase            String?
  investigationAdvice  String?
  referralDetails      String?
  prescriptions        String?
  tests                String?
  followUpDate         DateTime?                  @db.Date
  followUpInstructions String?
  admittedAt           DateTime?
  dischargedAt         DateTime?
  ward                 String?
  bed                  String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  clinic               Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient              Patient                    @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  createdBy            User                       @relation(fields: [clinicId, createdById], references: [clinicId, id], onDelete: Restrict)
  prescriptionItems    PrescriptionItem[]
  prescriptionVersions ConsultationPrescription[]
  vitalsRecords        PatientVitals[]
  reports              PatientReport[]
  nursingOrders        NursingOrder[]
  labOrders            LabOrder[]
  procedureOrders      ProcedureOrder[]
  queueToken           QueueToken?                @relation(fields: [clinicId, queueTokenId], references: [clinicId, id], onDelete: Restrict)
  queueTokenId         String?                    @db.Uuid
  invoices             Invoice[]

  @@unique([clinicId, id])
  @@unique([clinicId, queueTokenId])
  @@index([clinicId, patientId, visitDate])
  @@index([clinicId, encounterType, status])
}

model PatientVitals {
  id                     String           @id @default(uuid()) @db.Uuid
  clinicId               String           @db.Uuid
  patientId              String           @db.Uuid
  encounterId            String           @db.Uuid
  recordedById           String           @db.Uuid
  recordedAt             DateTime         @default(now())
  systolicMmHg           Int?
  diastolicMmHg          Int?
  pulseBpm               Int?
  respiratoryRateBpm     Int?
  temperatureC           Decimal?         @db.Decimal(5, 2)
  temperatureF           Decimal?         @db.Decimal(5, 2)
  temperatureEnteredUnit TemperatureUnit?
  spo2Percent            Decimal?         @db.Decimal(5, 2)
  cbgMgDl                Decimal?         @db.Decimal(7, 2)
  heightCm               Decimal?         @db.Decimal(6, 2)
  heightEnteredValue     String?
  heightEnteredUnit      HeightUnit?
  weightKg               Decimal?         @db.Decimal(6, 2)
  weightEnteredValue     Decimal?         @db.Decimal(7, 2)
  weightEnteredUnit      WeightUnit?
  bmi                    Decimal?         @db.Decimal(7, 2)
  clinic                 Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient                Patient          @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  encounter              PatientEncounter @relation(fields: [clinicId, encounterId], references: [clinicId, id], onDelete: Restrict)
  recordedBy             User             @relation(fields: [clinicId, recordedById], references: [clinicId, id], onDelete: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, encounterId, recordedAt])
  @@index([clinicId, patientId, recordedAt])
}

model PatientReport {
  id          String           @id @default(uuid()) @db.Uuid
  clinicId    String           @db.Uuid
  encounterId String           @db.Uuid
  name        String
  reportDate  DateTime?        @db.Date
  fileName    String?
  mimeType    String?
  fileDataUrl String?
  notes       String?
  createdAt   DateTime         @default(now())
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter   PatientEncounter @relation(fields: [clinicId, encounterId], references: [clinicId, id], onDelete: Cascade)

  @@unique([clinicId, id])
  @@index([clinicId, encounterId, reportDate])
}

model ExternalMedicalRecord {
  id             String   @id @default(uuid()) @db.Uuid
  clinicId       String   @db.Uuid
  patientId      String   @db.Uuid
  createdById    String   @db.Uuid
  recordDate     DateTime @db.Date
  recordType     String
  doctorName     String
  facilityName   String?
  diagnosis      String?
  treatment      String?
